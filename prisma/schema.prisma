// =====================================================================
// SP International School — School Management & Admission CRM Platform
// Canonical Prisma schema (PostgreSQL — production / Kuberns)
//
// Conventions:
//  - UUID string primary keys (never exposed sequential ints)
//  - created_at / updated_at on every table, soft references to users
//    via createdBy / updatedBy (User.id, no FK) where relevant
//  - Money is stored as INTEGER PAISE (₹1 = 100 paise) to avoid float
//    errors. See src/lib/money.ts for formatting helpers.
//  - Enum-like values are String columns validated by zod + TS constants
//    in src/lib/constants.ts (keeps schema portable across providers).
//  - A local-development twin of this schema exists at
//    prisma/schema.sqlite.prisma (identical models, sqlite provider).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// CORE
// ---------------------------------------------------------------

model School {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  address          String?
  city             String?
  state            String?
  pincode          String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String?  @default("#1e3a8a")
  accentColor      String?  @default("#b45309")
  boardAffiliation String?
  establishedYear  Int?
  timezone         String   @default("Asia/Kolkata")
  currency         String   @default("INR")
  dateFormat       String   @default("DD-MM-YYYY")
  locale           String   @default("en")
  socialLinks      String?  // JSON string {facebook,instagram,youtube,twitter,linkedin}
  policyContent    String?  // JSON string of editable policy page content
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicSessions AcademicSession[]
  leadSources      LeadSource[]
  admissionLeads   AdmissionLead[]
  applications     AdmissionApplication[]
  students         Student[]
  guardians        Guardian[]
  classRooms       ClassRoom[]
  feeCategories    FeeCategory[]
  feeComponents    FeeComponent[]
  feeStructures    FeeStructure[]
  invoices         Invoice[]
  payments         Payment[]
  receipts         Receipt[]
  notices          Notice[]
  events           Event[]
  mediaFiles       MediaFile[]
  galleryAlbums    GalleryAlbum[]
  numberSequences  NumberSequence[]
  websitePages     WebsitePage[]
  websiteNavItems  WebsiteNavigation[]
  siteSettings     SiteSetting[]
}

model AcademicSession {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id])
  leads        AdmissionLead[]
  applications AdmissionApplication[]
  students     Student[]
  classAssignments ClassAssignment[]
  feeStructures    FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  invoices         Invoice[]
  lateFeeRules     LateFeeRule[]

  @@unique([schoolId, name])
  @@index([isCurrent])
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userRoles          UserRole[]
  assignedLeads      AdmissionLead[]   @relation("LeadAssignee")
  paymentsReceived   Payment[]         @relation("PaymentReceiver")
  classTeacherSections Section[]       @relation("SectionClassTeacher")
  guardianProfile    Guardian?
  studentProfile     Student?
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // SUPER_ADMIN | PRINCIPAL | ...
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users        UserRole[]
  permissions  RolePermission[]
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique // e.g. leads.read, fees.write
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // soft ref User.id
  userRole    String?
  action      String   // LOGIN, LOGIN_FAILED, STUDENT_CREATE, FEE_PAYMENT_CREATE, ...
  entityType  String   // lead | student | invoice | payment | ...
  entityId    String?
  beforeData  String?  // JSON summary (before)
  afterData   String?  // JSON summary (after)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string
  category    String   @default("general")
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------
// ADMISSIONS CRM
// ---------------------------------------------------------------

model LeadSource {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // Website Form, Walk-in, Phone, WhatsApp, Referral, Social Media, Fair, Manual
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school School         @relation(fields: [schoolId], references: [id])
  leads  AdmissionLead[]

  @@unique([schoolId, name])
}

model AdmissionLead {
  id                 String    @id @default(uuid())
  schoolId           String
  leadNumber         String    @unique // LEAD-2025-26-00001
  studentName        String
  dateOfBirth        DateTime?
  gender             String?
  classApplyingFor   String?
  academicSessionId  String?
  guardianName       String
  mobile             String
  altMobile          String?
  email              String?
  address            String?
  city               String?
  previousSchool     String?
  leadSourceId       String?
  sourceNotes        String?
  assignedTo         String?   // User.id (counsellor)
  status             String    @default("NEW") // NEW | CONTACTED | FOLLOW_UP | VISIT_SCHEDULED | APPLICATION_STARTED | DOCUMENTS_PENDING | APPLICATION_SUBMITTED | ASSESSMENT_SCHEDULED | INTERVIEW_SCHEDULED | OFFER_MADE | ADMISSION_CONFIRMED | WAITLISTED | LOST | NOT_INTERESTED
  priority           String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  notes              String?
  nextFollowUpDate   DateTime?
  lostReason         String?
  createdById        String?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school          School            @relation(fields: [schoolId], references: [id])
  leadSource      LeadSource?       @relation(fields: [leadSourceId], references: [id])
  assignee        User?             @relation("LeadAssignee", fields: [assignedTo], references: [id])
  academicSession AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  activities      LeadActivity[]
  followups       LeadFollowup[]
  campusVisits    CampusVisit[]
  applications    AdmissionApplication[]

  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([academicSessionId])
  @@index([assignedTo])
  @@index([nextFollowUpDate])
  @@index([createdAt])
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  type        String   // NOTE | CALL | STATUS_CHANGE | EMAIL | WHATSAPP | VISIT | STAGE_MOVE
  title       String
  content     String?
  outcome     String?
  performedBy String?  // User.id
  createdAt   DateTime @default(now())

  lead AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model LeadFollowup {
  id          String    @id @default(uuid())
  leadId      String
  dueDate     DateTime
  note        String?
  status      String    @default("PENDING") // PENDING | DONE | MISSED | CANCELLED
  completedAt DateTime?
  completedBy String?
  createdById String?
  createdAt   DateTime  @default(now())

  lead AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, dueDate])
}

model CampusVisit {
  id            String    @id @default(uuid())
  leadId        String
  scheduledAt   DateTime
  status        String    @default("SCHEDULED") // SCHEDULED | COMPLETED | NO_SHOW | CANCELLED
  visitorName   String?
  visitorMobile String?
  notes         String?
  attendedBy    String?   // User.id
  createdById   String?
  createdAt     DateTime  @default(now())

  lead AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

model AdmissionApplication {
  id                String    @id @default(uuid())
  schoolId          String
  applicationNumber String    @unique // APP-2025-26-00001
  leadId            String?
  academicSessionId String
  classApplyingFor  String
  studentName       String
  dateOfBirth       DateTime?
  gender            String?
  guardianName      String
  mobile            String
  email             String?
  address           String?
  previousSchool    String?
  status            String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | ASSESSMENT_SCHEDULED | INTERVIEW_SCHEDULED | OFFER_MADE | ACCEPTED | REJECTED | WAITLISTED | WITHDRAWN
  submittedAt       DateTime?
  convertedStudentId String?  // soft ref Student.id after conversion
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School          @relation(fields: [schoolId], references: [id])
  lead            AdmissionLead?  @relation(fields: [leadId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  documents       ApplicationDocument[]
  decisions       AdmissionDecision[]

  @@index([status])
  @@index([academicSessionId])
  @@index([mobile])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  docType       String // BIRTH_CERTIFICATE | TRANSFER_CERTIFICATE | REPORT_CARD | ADDRESS_PROOF | PHOTO | OTHER
  fileName      String
  fileUrl       String
  mimeType      String?
  sizeBytes     Int?
  isVerified    Boolean  @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  remarks       String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model AdmissionDecision {
  id            String   @id @default(uuid())
  applicationId String
  decision      String // OFFER | ACCEPT | REJECT | WAITLIST
  remarks       String?
  decidedBy     String?
  decidedAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------
// STUDENT MANAGEMENT
// ---------------------------------------------------------------

model Student {
  id                String    @id @default(uuid())
  schoolId          String
  admissionNumber   String    @unique // SPIS/2025/0001
  academicSessionId String?   // current session (soft ref pattern ok) -> relation below
  rollNumber        String?
  firstName         String
  middleName        String?
  lastName          String?
  dateOfBirth       DateTime?
  gender            String?
  bloodGroup        String?
  nationality       String?
  religion          String?   // only if school policy requires
  categoryId        String?   // category placeholder (school policy)
  photoUrl          String?
  admissionDate     DateTime?
  classId           String?
  sectionId         String?
  house             String?   // placeholder
  transportRoute    String?   // placeholder
  hostelStatus      String?   // placeholder
  previousSchool    String?
  status            String    @default("ACTIVE") // ACTIVE | INACTIVE | ALUMNI | TRANSFERRED | WITHDRAWN
  userId            String?   @unique // student portal login
  createdById       String?
  deletedAt         DateTime? // soft delete: keeps ledger/history intact
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School            @relation(fields: [schoolId], references: [id])
  academicSession AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  classRoom       ClassRoom?        @relation(fields: [classId], references: [id])
  section         Section?          @relation(fields: [sectionId], references: [id])
  portalUser      User?             @relation(fields: [userId], references: [id])
  guardians       StudentGuardian[]
  approvedContacts ApprovedContact[]
  documents       StudentDocument[]
  statusHistory   StudentStatusHistory[]
  classAssignments ClassAssignment[]
  feeAssignments  StudentFeeAssignment[]
  invoices        Invoice[]
  payments        Payment[]
  receipts        Receipt[]
  concessions     Concession[]
  refunds         Refund[]
  feeAdjustments  FeeAdjustment[]
  attendanceRecords AttendanceRecord[]

  @@index([status])
  @@index([classId])
  @@index([sectionId])
  @@index([academicSessionId])
  @@index([firstName, lastName])
  @@index([dateOfBirth])
}

model Guardian {
  id                 String   @id @default(uuid())
  schoolId           String
  fullName           String
  relationship       String // FATHER | MOTHER | LOCAL_GUARDIAN | OTHER
  mobile             String
  altMobile          String?
  email              String?
  occupation         String?
  address            String?
  isPrimaryContact   Boolean  @default(false)
  isEmergencyContact Boolean  @default(false)
  consentStatus      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  consentAt          DateTime?
  userId             String?  @unique // parent portal login
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  portalUser  User?             @relation(fields: [userId], references: [id])
  students    StudentGuardian[]

  @@index([mobile])
  @@index([email])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

/// Authorised pickup / calling contacts per student. Feeds future
/// smart-card calling system integration. All changes are audited in
/// ApprovedContactAudit (immutable, append-only).
model ApprovedContact {
  id             String    @id @default(uuid())
  studentId      String
  contactName    String
  relationship   String
  mobile         String
  email          String?
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED
  approvedBy     String?   // User.id
  approvedAt     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  audits  ApprovedContactAudit[]

  @@index([studentId])
  @@index([mobile])
  @@index([approvalStatus])
}

model ApprovedContactAudit {
  id               String   @id @default(uuid())
  approvedContactId String
  action           String // CREATED | UPDATED | APPROVED | REJECTED | REVOKED | REMOVED
  beforeData       String?
  afterData        String?
  performedBy      String?
  performedByRole  String?
  createdAt        DateTime @default(now())

  approvedContact ApprovedContact @relation(fields: [approvedContactId], references: [id], onDelete: Cascade)

  @@index([approvedContactId])
}

model ClassRoom {
  id          String   @id @default(uuid())
  schoolId    String
  name        String // "Nursery", "Class 1" ... "Class 12"
  level       Int // ordering
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School            @relation(fields: [schoolId], references: [id])
  sections      Section[]
  students      Student[]
  classAssignments ClassAssignment[]
  feeStructures FeeStructure[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, name])
  @@index([level])
}

model Section {
  id             String   @id @default(uuid())
  schoolId       String
  classId        String
  name           String // "A", "B"
  capacity       Int?
  classTeacherId String?  // User.id
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classRoom   ClassRoom @relation(fields: [classId], references: [id])
  classTeacher User?     @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  students    Student[]
  classAssignments ClassAssignment[]
  attendanceSessions AttendanceSession[]

  @@unique([classId, name])
}

model ClassAssignment {
  id                String   @id @default(uuid())
  studentId         String
  classId           String
  sectionId         String?
  academicSessionId String
  rollNumber        String?
  assignedAt        DateTime @default(now())
  assignedBy        String?
  isActive          Boolean  @default(true)
  endDate           DateTime?

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom       ClassRoom       @relation(fields: [classId], references: [id])
  section         Section?        @relation(fields: [sectionId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@index([studentId])
  @@index([academicSessionId])
  @@index([classId, sectionId])
}

model StudentDocument {
  id         String    @id @default(uuid())
  studentId  String
  docType    String
  fileName   String
  fileUrl    String
  mimeType   String?
  sizeBytes  Int?
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([docType])
}

model StudentStatusHistory {
  id         String   @id @default(uuid())
  studentId  String
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?
  changedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------------------------------------------------------------
// FEES
// ---------------------------------------------------------------

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String
  name        String // Academic | One-time | Transport | Activities ...
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school School          @relation(fields: [schoolId], references: [id])
  items  FeeStructureItem[]

  @@unique([schoolId, name])
}

model FeeComponent {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // Admission Fee, Tuition Fee, ...
  code      String   @unique // ADMISSION, TUITION, ANNUAL, EXAM, LAB, LIBRARY, TRANSPORT, HOSTEL, ACTIVITY, SMART_CLASS, CUSTOM_*
  isCustom  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school      School             @relation(fields: [schoolId], references: [id])
  items       FeeStructureItem[]
  concessions Concession[]
  invoiceItems InvoiceItem[]
}

model FeeStructure {
  id                String    @id @default(uuid())
  schoolId          String
  academicSessionId String
  classId           String
  name              String
  totalAmount       Int       @default(0) // paise, denormalised sum
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            String    @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School                 @relation(fields: [schoolId], references: [id])
  academicSession AcademicSession        @relation(fields: [academicSessionId], references: [id])
  classRoom       ClassRoom              @relation(fields: [classId], references: [id])
  items           FeeStructureItem[]
  studentAssignments StudentFeeAssignment[]

  @@unique([academicSessionId, classId, name])
  @@index([status])
}

model FeeStructureItem {
  id              String  @id @default(uuid())
  feeStructureId  String
  feeComponentId  String
  feeCategoryId   String?
  amount          Int // paise
  frequency       String // MONTHLY | QUARTERLY | ANNUAL | ONE_TIME
  dueDay          Int?    // day-of-month due date (e.g. 10)
  installmentCount Int    @default(1)

  feeStructure FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent  @relation(fields: [feeComponentId], references: [id])
  feeCategory  FeeCategory?  @relation(fields: [feeCategoryId], references: [id])

  @@index([feeStructureId])
}

model StudentFeeAssignment {
  id                String   @id @default(uuid())
  studentId         String
  feeStructureId    String
  academicSessionId String
  assignedAt        DateTime @default(now())
  assignedBy        String?
  isActive          Boolean  @default(true)

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure    FeeStructure    @relation(fields: [feeStructureId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@unique([studentId, feeStructureId])
  @@index([academicSessionId])
}

model Invoice {
  id                String    @id @default(uuid())
  schoolId          String
  invoiceNumber     String    @unique // INV-2025-26-000123
  studentId         String
  academicSessionId String
  issueDate         DateTime  @default(now())
  dueDate           DateTime?
  periodLabel       String? // "Apr 2025" | "Q1 2025-26" | "Annual 2025-26"
  status            String    @default("ISSUED") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  subtotal          Int       @default(0)
  discountTotal     Int       @default(0)
  lateFeeTotal      Int       @default(0)
  total             Int       @default(0)
  paidTotal         Int       @default(0)
  balance           Int       @default(0)
  notes             String?
  generatedBy       String?
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School          @relation(fields: [schoolId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  allocations     PaymentAllocation[]
  concessions     Concession[]
  feeAdjustments  FeeAdjustment[]
  receipts        Receipt[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([academicSessionId])
}

model InvoiceItem {
  id           String  @id @default(uuid())
  invoiceId    String
  feeComponentId String?
  description  String
  amount       Int // paise
  discount     Int     @default(0)
  taxAmount    Int     @default(0) // GST only if configured
  total        Int
  periodLabel  String?

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent? @relation(fields: [feeComponentId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id                String    @id @default(uuid())
  schoolId          String
  invoiceId         String?   // null => advance payment (credit balance)
  studentId         String
  amount            Int // paise actually received
  mode              String // CASH | CHEQUE | BANK_TRANSFER | UPI | ONLINE | ADJUSTMENT
  status            String    @default("PENDING") // PENDING | CONFIRMED | FAILED | CANCELLED | REFUNDED
  referenceNumber   String?   // cheque no / txn ref / utr
  chequeNumber      String?
  chequeDate        DateTime?
  bankName          String?
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  paidAt            DateTime?
  receivedBy        String?   // User.id
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school       School              @relation(fields: [schoolId], references: [id])
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  receiver     User?               @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  allocations  PaymentAllocation[]
  receipts     Receipt[]
  refunds      Refund[]

  @@index([studentId])
  @@index([invoiceId])
  @@index([status])
  @@index([mode])
  @@index([paidAt])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
}

model PaymentAllocation {
  id            String   @id @default(uuid())
  paymentId     String
  invoiceId     String
  invoiceItemId String?
  amount        Int // paise applied to invoice
  allocatedAt   DateTime @default(now())
  allocatedBy   String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
}

model PaymentGatewayEvent {
  id             String    @id @default(uuid())
  provider       String // razorpay | placeholder ...
  eventId        String    @unique // gateway event id OR provider|orderId|paymentId hash for idempotency
  eventType      String
  orderId        String?
  gatewayPaymentId String?
  payload        String?   // raw JSON
  signatureValid Boolean   @default(false)
  status         String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  error          String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([orderId])
}

model Receipt {
  id            String    @id @default(uuid())
  schoolId      String
  receiptNumber String    @unique // RCP-2025-26-000123
  paymentId     String
  studentId     String
  invoiceId     String?
  amount        Int
  issuedAt      DateTime  @default(now())
  issuedBy      String?
  isDuplicate   Boolean   @default(false)
  duplicateOf   String?   // original receiptNumber
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([studentId])
  @@index([issuedAt])
}

model Concession {
  id             String    @id @default(uuid())
  schoolId       String
  studentId      String
  invoiceId      String?
  feeComponentId String?
  type           String // SCHOLARSHIP | SIBLING | STAFF_WARD | SPORTS | NEED_BASED | OTHER
  percent        Float?
  amount         Int? // flat paise (either percent or amount)
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  requestedBy    String?
  approvedBy     String?
  approvedAt     DateTime?
  appliedAt      DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  feeComponent FeeComponent? @relation(fields: [feeComponentId], references: [id])

  @@index([studentId])
  @@index([status])
}

model Refund {
  id              String    @id @default(uuid())
  schoolId        String
  paymentId       String
  studentId       String
  amount          Int
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | PROCESSED | REJECTED
  requestedBy     String?
  approvedBy      String?
  approvedAt      DateTime?
  processedAt     DateTime?
  referenceNumber String?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
}

model FeeAdjustment {
  id          String    @id @default(uuid())
  schoolId    String
  studentId   String
  invoiceId   String?
  type        String // DEBIT | CREDIT
  amount      Int
  reason      String
  status      String    @default("PENDING") // PENDING | APPROVED | APPLIED | REJECTED
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student  @relation(fields: [studentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([studentId])
  @@index([status])
}

model LateFeeRule {
  id                String    @id @default(uuid())
  schoolId          String
  academicSessionId String?
  classId           String?
  name              String
  feeComponentId    String?
  ruleType          String // FIXED | PERCENT_PER_DAY | PERCENT_PER_MONTH | ONE_TIME
  amount            Int       @default(0) // paise (fixed) — percent stored in percent
  percent           Float?
  gracePeriodDays   Int       @default(0)
  maxAmount         Int?
  isActive          Boolean   @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdAt         DateTime  @default(now())

  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id])

  @@index([isActive])
}

model NumberSequence {
  id           String @id @default(uuid())
  schoolId     String
  key          String // e.g. INVOICE:2025-26 | RECEIPT:2025-26 | LEAD:2025-26 | APPLICATION:2025-26
  prefix       String
  currentValue Int    @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
}

// ---------------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------------

model AttendanceSession {
  id          String   @id @default(uuid())
  schoolId    String
  classId     String
  sectionId   String?
  date        DateTime // date part used (stored as UTC midnight)
  sessionType String   @default("FULL_DAY") // FULL_DAY | HALF_DAY | SUBJECT
  subject     String?
  markedBy    String?
  markedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classRoom ClassRoom          @relation(fields: [classId], references: [id])
  section   Section?           @relation(fields: [sectionId], references: [id])
  records   AttendanceRecord[]

  @@unique([classId, sectionId, date, sessionType])
  @@index([date])
}

model AttendanceRecord {
  id                  String   @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              String // PRESENT | ABSENT | LATE | LEAVE | HOLIDAY
  remarks             String?
  markedBy            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id])

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------
// COMMUNICATION
// ---------------------------------------------------------------

model Notice {
  id            String    @id @default(uuid())
  schoolId      String
  title         String
  slug          String    @unique
  content       String
  category      String    @default("GENERAL") // GENERAL | ACADEMIC | EVENT | ADMISSION | FEE | URGENT
  audience      String    @default("PUBLIC") // PUBLIC | PARENTS | STUDENTS | STAFF | ALL
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  expiresAt     DateTime?
  attachmentUrl String?
  attachmentName String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([isPublished, publishedAt])
  @@index([category])
}

model Event {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  slug        String    @unique
  description String
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  imageUrl    String?
  isPublic    Boolean   @default(true)
  isPublished Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([startsAt])
  @@index([isPublished])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  schoolId  String
  key       String   @unique // fee_receipt | payment_reminder | lead_followup ...
  channel   String // EMAIL | SMS | WHATSAPP | PUSH
  subject   String?
  body      String
  variables String? // JSON array of variable names
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CommunicationLog {
  id              String   @id @default(uuid())
  schoolId        String
  channel         String // EMAIL | SMS | WHATSAPP | PHONE | IN_PERSON
  direction       String   @default("OUTBOUND") // OUTBOUND | INBOUND
  subject         String?
  content         String?
  relatedStudentId String?  // soft refs
  relatedLeadId   String?
  relatedUserId   String?
  sentBy          String?
  status          String   @default("SENT") // QUEUED | SENT | FAILED | RECEIVED
  provider        String?
  providerMessageId String?
  error           String?
  createdAt       DateTime @default(now())

  @@index([relatedStudentId])
  @@index([relatedLeadId])
  @@index([channel, createdAt])
}

model ParentMessage {
  id            String    @id @default(uuid())
  schoolId      String
  studentId     String?
  parentUserId  String?
  teacherUserId String?
  subject       String
  body          String
  direction     String    @default("OUTBOUND")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------
// DOCUMENTS / WEBSITE CONTENT
// ---------------------------------------------------------------

model MediaFile {
  id           String    @id @default(uuid())
  schoolId     String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String    @unique // non-guessable uuid path under /uploads
  publicUrl    String?
  uploadedBy   String?
  tags         String?
  deletedAt    DateTime? // soft delete for recoverability
  createdAt    DateTime  @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  galleryItems GalleryItem[]

  @@index([schoolId])
  @@index([tags])
}

model GalleryAlbum {
  id           String   @id @default(uuid())
  schoolId     String
  title        String
  slug         String   @unique
  description  String?
  coverImageId String?
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School        @relation(fields: [schoolId], references: [id])
  items  GalleryItem[]
}

model GalleryItem {
  id          String  @id @default(uuid())
  albumId     String
  mediaFileId String
  caption     String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaFile MediaFile    @relation(fields: [mediaFileId], references: [id])

  @@index([albumId])
}

model WebsitePage {
  id              String   @id @default(uuid())
  schoolId        String
  slug            String   @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model WebsiteNavigation {
  id         String  @id @default(uuid())
  schoolId   String
  label      String
  url        String
  sortOrder  Int     @default(0)
  location   String  @default("HEADER") // HEADER | FOOTER | QUICK_LINKS
  isPublished Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])
}

model SiteSetting {
  id        String   @id @default(uuid())
  schoolId  String
  key       String
  value     String   // JSON string — editable website content blocks
  category  String   @default("website")
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
}

// ---------------------------------------------------------------
// SYSTEM
// ---------------------------------------------------------------

model Job {
  id             String    @id @default(uuid())
  schoolId       String?
  name           String
  type           String // LATE_FEE_EVALUATION | PAYMENT_REMINDER | REPORT_EXPORT | BACKUP ...
  cronExpression String?
  payload        String?
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs JobRun[]
}

model JobRun {
  id         String    @id @default(uuid())
  jobId      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  output     String?
  error      String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
}

model ErrorLog {
  id        String   @id @default(uuid())
  level     String   @default("error") // error | warn | info
  message   String
  stack     String?
  context   String?  // JSON
  userId    String?
  path      String?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

model DataExport {
  id          String    @id @default(uuid())
  requestedBy String
  exportType  String // leads | students | invoices | payments | audit_logs ...
  filters     String?   // JSON
  status      String    @default("QUEUED") // QUEUED | PROCESSING | READY | FAILED
  fileUrl     String?
  rowCount    Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model BackupLog {
  id          String    @id @default(uuid())
  type        String    @default("MANUAL") // MANUAL | AUTO
  status      String    @default("STARTED") // STARTED | SUCCESS | FAILED
  fileUrl     String?
  sizeBytes   Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  triggeredBy String?
}
